# ## Cell 3: Check GPU
import torch
print(f"GPU available: {torch.cuda.is_available()}")
if torch.cuda.is_available():
    print(f"GPU name: {torch.cuda.get_device_name(0)}")
    print(f"GPU memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB")

# ## Cell 4: Load model
from qwen_tts import Qwen3TTSModel

model = Qwen3TTSModel.from_pretrained(
    "Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign",
    torch_dtype="auto",
    device_map="auto"
)
print("Model loaded successfully!")

# ## Cell 5: Design voices
# Spiritual Guide — deep, warm, British
spiritual_voice = model.voice_design(
    text="Welcome to Spiritual Sleep. Tonight, we read from the Corpus Hermeticum.",
    instruct="A deep, warm male voice. Slow, measured pace. Authoritative but gentle. British accent."
)

# Storyteller — soft, gentle, female
story_voice = model.voice_design(
    text="Once upon a time, in a land far away, there lived a princess.",
    instruct="A soft, gentle female voice. Warm, storytelling tone. Slight smile in the voice."
)

# Lecturer — clear, neutral, technical
mind_voice = model.voice_design(
    text="The A18 chip features a 6-core CPU with 2 performance and 4 efficiency cores.",
    instruct="A clear, neutral male voice. Precise, technical. American accent."
)

# Mystic — mysterious, deep, resonant
mystic_voice = model.voice_design(
    text="The Tree of Life has ten emanations. Each is a sphere of divine energy.",
    instruct="A mysterious, measured voice. Deep resonance. Slow, deliberate pace."
)

# Healer — warm, friendly, hopeful
healer_voice = model.voice_design(
    text="Tonight's good news from around the world. The world is kinder than the headlines say.",
    instruct="A warm, friendly female voice. Hopeful tone. Gentle smile."
)

print("Voices designed!")

# ## Cell 6: Generate test audio
import soundfile as sf

# Test 1: Etymology (Spiritual voice)
output1 = model.generate(
    text="Salary. From Latin salarium. Salt money. Roman soldiers were paid in salt. This is why we say someone is 'worth their salt'. And this is why we say 'salad'. From Latin salata, salted things.",
    voice=spiritual_voice
)
sf.write("test_spiritual.wav", output1.audio, output1.sample_rate)

# Test 2: Fairy Tale (Story voice)
output2 = model.generate(
    text="The Snow Queen. Hans Christian Andersen. The mirror and the fragment. The mirror, it was so remarkable that everything reflected in it was diminished and made worse.",
    voice=story_voice
)
sf.write("test_story.wav", output2.audio, output2.sample_rate)

# Test 3: Product Spec (Mind voice)
output3 = model.generate(
    text="iPhone 16. Year introduced 2024. Width 71.6 millimeters. Height 147.6 millimeters. Weight 170 grams. Display Super Retina XDR. 6.1 inch OLED.",
    voice=mind_voice
)
sf.write("test_mind.wav", output3.audio, output3.sample_rate)

# Test 4: Esoteric (Mystic voice)
output4 = model.generate(
    text="The Tree of Life has ten emanations. Kether, the crown. Chokmah, wisdom. Binah, understanding. Each sphere is a divine energy.",
    voice=mystic_voice
)
sf.write("test_mystic.wav", output4.audio, output4.sample_rate)

# Test 5: Good News (Healer voice)
output5 = model.generate(
    text="Tonight's good news. In Japan, a town where robots help elderly farmers. In Brazil, a community saves the last Atlantic forest patch. In Scotland, a 100 year old finishes her first marathon.",
    voice=healer_voice
)
sf.write("test_healer.wav", output5.audio, output5.sample_rate)

print("All test audio files saved!")
print("Files: test_spiritual.wav, test_story.wav, test_mind.wav, test_mystic.wav, test_healer.wav")

