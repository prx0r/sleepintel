{
  "model": "typesafe/jev-1.13 via OpenRouter (Decisions API + System One API, key in env)",
  "decisions": [
    {"at": "pilot-proposed", "primitive": "choice", "question": "promote / iterate / kill this pilot?", "inputs": ["predicted EV", "engine cost", "corpus strength", "rights status"], "acts": {"promote": "queue render", "iterate": "name one variable, re-queue", "kill": "retain as data"}},
    {"at": "pre-publish", "primitive": "noul", "question": "does this render clear the bar?", "inputs": ["uniqueness score", "lint pass", "dash verify", "rights ledger complete"], "threshold": 0.8, "acts": {"true": "ship", "false": "regenerate variant"}},
    {"at": "verdict-week", "primitive": "choice", "question": "which hypothesis resolved and how?", "inputs": ["tracked series vs prediction thresholds"], "acts": {"playing_out": "shift resources in", "not_playing_out": "shift out, keep note"}},
    {"at": "render-step", "primitive": "score", "question": "sleepiness of this cut 1-10?", "inputs": ["pace", "caption mode", "bed level", "voice rate"], "acts": {">=7": "ship", "<7": "slow a dial, re-render"}}
  ]
}
